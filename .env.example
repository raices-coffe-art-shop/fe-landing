# URL pública canónica del sitio, sin slash final (ej. https://raicescoffee.com).
# Requerida en producción: alimenta canonicals, sitemap, JSON-LD y los QR de la carta.
NEXT_PUBLIC_SITE_URL=
# Token de verificación de Google Search Console (meta tag). Opcional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# URL de embed de Google Maps para la sección de visita. Opcional (hay fallback por coordenadas).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-02
SANITY_REVALIDATE_SECRET=
# Token privado usado por la migración y por las consultas server-side cuando el dataset es privado.
# No usar NEXT_PUBLIC_. No subir .env.local a Git.
SANITY_API_WRITE_TOKEN=
